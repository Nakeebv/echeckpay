# ── database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── sessions & signing ──────────────────────────────────────────────────────
AUTH_SECRET=change-to-a-long-random-string-in-production

# ── operator bootstrap (first seed only) ────────────────────────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-strong-10+!

# ── NOWPayments (crypto deposits) ───────────────────────────────────────────
NOWPAYMENTS_API_KEY=your-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret
# optional (sandbox): NOWPAYMENTS_API_BASE_URL=https://api-sandbox.nowpayments.io/v1

# ── email (password recovery / verification) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=eCheckPay <onboarding@resend.dev>
APP_BASE_URL=https://your-app.example.com
